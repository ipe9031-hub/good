{
  "name": "ppt-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "dev": "vite --config apps/powerpoint-addin/vite.config.ts",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build --config apps/powerpoint-addin/vite.config.ts",
    "test": "vitest run",
    "test:browser": "playwright test",
    "certs": "office-addin-dev-certs install",
    "validate:manifest": "node scripts/validate-manifest.mjs --online",
    "package:windows": "node scripts/package-windows.mjs",
    "validate:manifest:local": "node scripts/validate-manifest.mjs",
    "manifest:production": "node scripts/manifest-production.mjs"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/office-js": "^1.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/xml2js": "^0.4.14",
    "@vitejs/plugin-react": "^4.7.0",
    "fflate": "^0.8.2",
    "https-proxy-agent": "^9.1.0",
    "office-addin-dev-certs": "^2.0.0",
    "office-addin-manifest": "^2.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vite": "^6.4.0",
    "vitest": "^3.2.0",
    "xml2js": "^0.6.2"
  }
}
