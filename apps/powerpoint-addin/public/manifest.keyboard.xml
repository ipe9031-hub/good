<?xml version="1.0" encoding="UTF-8"?>
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0" xsi:type="TaskPaneApp">
  <Id>0f8ed266-5d44-4bcc-8371-4db9562d617f</Id>
  <Version>0.2.4.0</Version>
  <ProviderName>PPT AI Studio</ProviderName>
  <DefaultLocale>ko-KR</DefaultLocale>
  <DisplayName DefaultValue="PPT AI Studio 단축키"/>
  <Description DefaultValue="PowerPoint 안에서 텍스트, 도형, 사진을 정밀하게 편집합니다."/>
  <IconUrl DefaultValue="https://good-red.vercel.app/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://good-red.vercel.app/assets/icon-80.png"/>
  <SupportUrl DefaultValue="https://github.com/ipe9031-hub/good/issues"/>
  <AppDomains><AppDomain>https://good-red.vercel.app</AppDomain></AppDomains>
  <Hosts><Host Name="Presentation"/></Hosts>
  <Requirements><Sets DefaultMinVersion="1.5"><Set Name="PowerPointApi" MinVersion="1.5"/><Set Name="SharedRuntime" MinVersion="1.1"/></Sets></Requirements>
  <DefaultSettings><SourceLocation DefaultValue="https://good-red.vercel.app/index.html?addin=hosted&amp;v=0.2.4&amp;keyboard=1"/></DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts><Host xsi:type="Presentation"><Runtimes><Runtime resid="Taskpane.Url" lifetime="long"/></Runtimes><DesktopFormFactor>
      <FunctionFile resid="Taskpane.Url"/>
      <ExtensionPoint xsi:type="PrimaryCommandSurface">
        <CustomTab id="PPTAIStudio.Tab">
          <Group id="PPTAIStudio.Group"><Label resid="Group.Label"/>
            <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
            <Control xsi:type="Button" id="PPTAIStudio.Open">
              <Label resid="Button.Label"/>
              <Supertip><Title resid="Button.Label"/><Description resid="Button.Description"/></Supertip>
              <Icon><bt:Image size="16" resid="Icon.16"/><bt:Image size="32" resid="Icon.32"/><bt:Image size="80" resid="Icon.80"/></Icon>
              <Action xsi:type="ShowTaskpane"><SourceLocation resid="Taskpane.Url"/></Action>
            </Control>
          </Group>
          <Label resid="Tab.Label"/>
        </CustomTab>
      </ExtensionPoint>
    </DesktopFormFactor></Host></Hosts>
    <Resources>
      <bt:Images><bt:Image id="Icon.16" DefaultValue="https://good-red.vercel.app/assets/icon-16.png"/><bt:Image id="Icon.32" DefaultValue="https://good-red.vercel.app/assets/icon-32.png"/><bt:Image id="Icon.80" DefaultValue="https://good-red.vercel.app/assets/icon-80.png"/></bt:Images>
      <bt:Urls><bt:Url id="Commands.Url" DefaultValue="https://good-red.vercel.app/commands.html?addin=hosted&amp;v=0.2.4"/><bt:Url id="Taskpane.Url" DefaultValue="https://good-red.vercel.app/index.html?addin=hosted&amp;v=0.2.4&amp;keyboard=1"/></bt:Urls>
      <bt:ShortStrings><bt:String id="Tab.Label" DefaultValue="PPT AI Studio 단축키"/><bt:String id="Group.Label" DefaultValue="편집 스튜디오"/><bt:String id="Button.Label" DefaultValue="스튜디오 열기"/></bt:ShortStrings>
      <bt:LongStrings><bt:String id="Button.Description" DefaultValue="PPT AI Studio 작업창에서 텍스트, 도형, 사진을 추가하고 편집합니다."/></bt:LongStrings>
    </Resources>
  </VersionOverrides>
<ExtendedOverrides Url="https://good-red.vercel.app/shortcuts.json?v=0.2.4"/></OfficeApp>
